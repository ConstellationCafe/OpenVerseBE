# /etc/openverse/openverse.env  (chmod 640, owner root:openverse)
# Shared by openversebe.service and openverse-battle.service

# --- Redis (both services) ---
# password must match requirepass in /etc/redis/redis.conf
OVBE_REDIS=127.0.0.1:6379,password=CHANGE_ME_REDIS_PASSWORD
OPENVERSE_REDIS=127.0.0.1:6379,password=CHANGE_ME_REDIS_PASSWORD
# both sides must use the same prefix
OVBE_KEY_PREFIX=ov:
OPENVERSE_REDIS_PREFIX=ov:

# --- OpenVerseBE ---
# what players' games connect to for battles: your DDNS name (or public IP) and the battle port, no scheme
OVBE_NODE_URL=ov.example.com:3001
# players put the same value in cafe_key.txt next to openverse-launcher.exe. leave empty to allow anyone
OVBE_CAFE_KEY=CHANGE_ME_CAFE_KEY
# how long an idle room lives
OVBE_ROOM_TTL_MINUTES=180
# rooms open at once across the server; 0 = no limit
OVBE_MAX_ROOMS=10

# --- OpenVerse.Battle ---
# Observe | AdviseCost | AnswerBlanks. only matters when the engine assemblies are present; without them the
# battle server relays only
OPENVERSE_ENGINE_ROLE=AnswerBlanks
