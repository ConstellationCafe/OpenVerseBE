# Copy to .env and fill in. docker compose reads it automatically.

# Your server's DNS name (DDNS is fine). Players put https://<this> in be_url.txt.
# Give it an A record only, no AAAA: the seat check compares IPv4 addresses.
OVBE_DOMAIN=ov.example.com

# Only if players reach OpenVerseBE under a path of a shared domain (deploy/nginx/openverse-path.conf).
# This is what goes into be_url.txt; the smoke test uses it too. Leave commented for a domain of its own.
# OVBE_PUBLIC_URL=https://ov.example.com/openverse

# Letters and digits only (it is embedded in a connection string)
REDIS_PASSWORD=change-me-to-a-long-random-string

# Players put the same value in cafe_key.txt. Empty = anyone may register.
OVBE_CAFE_KEY=change-me

# How long an idle room lives (minutes)
OVBE_ROOM_TTL_MINUTES=180

# How many rooms may be open at once on the whole server. 0 = no limit.
# When it is reached, creating a room is refused (HTTP 503 room_limit) until one closes or times out.
OVBE_MAX_ROOMS=10

# Which OpenVerse branch/tag the battle server is built from
OPENVERSE_REF=main

# Folder holding card_master_full.csv.gz. Default ./data next to docker-compose.yml.
# With CD (which replaces the checkout on every deploy) it must be outside it:
# OVBE_DATA_DIR=/home/elaina/dockers/OpenVerseBE/data

# A copy of a player's Shadowverse data folder (%UserProfile%\AppData\LocalLow\Cygames\Shadowverse, ~13 GB),
# served to players whose own copy is missing files. Unset = no game files served (rooms still work).
# Outside the checkout, like OVBE_DATA_DIR. The card master served alongside is the one in OVBE_DATA_DIR.
# OVBE_ASSET_DIR=/home/elaina/dockers/OpenVerseBE/shadowverse

# Upload budget for game files in Mbit/s, shared by everyone downloading at the moment: one player gets all of it,
# two get half each. 0 = no limit. 64 fits a 100 Mbit/s line (13.3 GB in ~30 min for one player, ~1 h each for two)
# and leaves ~30 Mbit/s for battles and other sites. Raise it with the line.
OVBE_ASSET_RATE_MBPS=64
# How many players download at once; the rest wait in line, first come first served. 0 = no line.
OVBE_ASSET_MAX_ACTIVE=2
# A downloading player who asks for nothing this many seconds gives the place to the next in line.
OVBE_ASSET_IDLE_SECONDS=120

# Observe | AdviseCost | AnswerBlanks (only matters if the engine assemblies are ever added)
OPENVERSE_ENGINE_ROLE=AnswerBlanks
